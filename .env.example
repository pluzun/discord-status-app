# ============================================================
#  discord-weather-status — configuration
# ============================================================
#  Copiez ce fichier en ".env" et remplissez les valeurs.
#  Ne commitez JAMAIS votre .env dans git.
# ============================================================

# ----------------------------------------------------------
# Token de votre compte Discord PERSONNEL (pas un bot token)
#
# Comment l'obtenir :
#   1. Ouvrez Discord dans votre navigateur (discord.com/app)
#   2. F12 → onglet "Network"
#   3. Filtrez par "api"
#   4. Rechargez la page, cliquez sur n'importe quelle requête
#   5. Dans les headers, copiez la valeur "Authorization"
#
# ⚠️  Ce token donne un accès TOTAL à votre compte.
#      Ne le partagez jamais. Ne le commitez jamais.
# ⚠️  Utiliser un token utilisateur dans un script automatisé
#      est contraire aux CGU Discord.
# ----------------------------------------------------------
DISCORD_TOKEN=votre_token_utilisateur_ici

# ----------------------------------------------------------
# Clé API OpenWeatherMap (plan gratuit suffisant)
#
# Inscription : https://openweathermap.org/api
# Tableau de bord : https://home.openweathermap.org/api_keys
#
# Note : les nouvelles clés peuvent prendre 10 min à activer.
# ----------------------------------------------------------
OPENWEATHER_API_KEY=votre_cle_openweathermap_ici

# ----------------------------------------------------------
# Ville utilisée pour la météo
# Exemples : Paris, Lyon, "New York", Tokyo
# ----------------------------------------------------------
CITY=Paris

# ----------------------------------------------------------
# Intervalle de mise à jour du status en minutes (défaut: 15)
# Évitez les valeurs trop faibles pour ne pas spammer l'API.
# ----------------------------------------------------------
UPDATE_INTERVAL_MINUTES=15
